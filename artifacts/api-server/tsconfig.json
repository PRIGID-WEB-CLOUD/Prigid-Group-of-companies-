{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,
    "noUnusedLocals": false,
    "strictPropertyInitialization": false,
    "paths": {
      "@workspace/db": ["../../lib/db/src/index.ts"],
      "@workspace/db/*": ["../../lib/db/src/*"],
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"],
      "@workspace/api-zod/*": ["../../lib/api-zod/src/*"],
      "@workspace/tenant-routing": ["../../lib/tenant-routing/src/index.ts"],
      "@workspace/tenant-routing/*": ["../../lib/tenant-routing/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/tenant-routing"
    }
  ]
}
