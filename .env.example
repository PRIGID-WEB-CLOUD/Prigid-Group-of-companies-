# ==============================================================================
# LUXE BOUTIQUE — MASTER PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Quick Start:
# 1. Copy this file to .env in your root directory: cp .env.example .env
# 2. Configure SECTION 1 (Only these 6 variables are required to boot up).
# 3. Configure any payment, social, email, or shipping connectors in Sections 2–8
#    only when you wish to activate that feature.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🟢 SECTION 1: CORE SERVER & INFRASTRUCTURE (MANDATORY TO BOOT)
# ------------------------------------------------------------------------------
# Web server listening port (Default: 3000)
PORT=3000

# Environment mode (Must be "production" for live deployment)
# Setting to production disables dev bypasses, secures cookies, and hides demo login
NODE_ENV=production

# PostgreSQL Database Connection URI
# Supports any Postgres provider (Neon, Supabase, Railway, Render, AWS RDS, local)
# Cloud databases require "?sslmode=require" at the end of the URL
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Optional Postgres connection settings
PGSSLMODE=require
PGCONNECT_TIMEOUT=15

# Session Signing & Cookie Encryption Secret (32+ random characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=create_a_secure_random_32_character_session_key_here

# Master Database Credential Encryption Key (32+ random characters)
# Used by AES-256-GCM vault to encrypt third-party tokens stored in database
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=create_a_secure_random_32_character_vault_key_here

# Initial Super Admin Bootstrap Secret
# Used once via header 'X-Admin-Bootstrap-Secret' or at /admin to create first admin.
# After the first admin account is registered, this route locks permanently.
ADMIN_BOOTSTRAP_SECRET=create_your_initial_admin_password_123

# Canonical Public URLs & CORS Origins
APP_URL=https://yourstore.com
PUBLIC_APP_URL=https://yourstore.com
ADMIN_URL=https://yourstore.com/admin
CORS_ALLOWED_ORIGINS=https://yourstore.com,https://admin.yourstore.com

# Logger Verbosity: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 🟡 SECTION 2: CUSTOMER & STAFF AUTHENTICATION (GOOGLE OAUTH 2.0)
# ------------------------------------------------------------------------------
# Enables "Sign in with Google" on customer storefront and admin dashboard
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: https://yourstore.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 🟡 SECTION 3: PAYMENT PROCESSING GATEWAYS (MODULAR — USE WHAT YOU NEED)
# ------------------------------------------------------------------------------
# 1. PAYSTACK (Recommended for Ghana, Nigeria, Kenya, South Africa)
# Supports Mobile Money (MTN, Telecel, AT), Cards, and Bank Transfer
# Obtain from: https://dashboard.paystack.com/#/settings/developer
# Webhook URL to set in Paystack: https://yourstore.com/api/webhooks/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CLIENT_ID=

# 2. FLUTTERWAVE (Pan-African Mobile Money & Cards across 150+ currencies)
# Obtain from: https://dashboard.flutterwave.com/dashboard/settings/apis
# Webhook URL to set in Flutterwave: https://yourstore.com/api/webhooks/flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLW_SECRET_HASH=
FLUTTERWAVE_CLIENT_ID=

# 3. STRIPE (Global Credit/Debit Cards, Apple Pay, Google Pay, Klarna)
# Obtain from: https://dashboard.stripe.com/apikeys
# Webhook URL to set in Stripe: https://yourstore.com/api/webhooks/stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=

# 4. PAYPAL (International digital wallet & installment financing)
# Obtain from: https://developer.paypal.com/dashboard/applications/
# Webhook URL to set in PayPal: https://yourstore.com/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 🟡 SECTION 4: GEOLOCATION & MAPS (GOOGLE MAPS PLATFORM)
# ------------------------------------------------------------------------------
# Powers checkout shipping address autocomplete, delivery distance, and map pins
# Obtain from: https://console.cloud.google.com/google/maps-apis
# Required enabled APIs: Places API (New), Geocoding API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 🟡 SECTION 5: SOCIAL COMMERCE & CHANNELS (META & TWITTER/X)
# ------------------------------------------------------------------------------
# 1. META BUSINESS SUITE (Facebook Shop, Instagram Shopping, Messenger)
# Obtain from: https://developers.facebook.com/
# OAuth Redirect URI: https://yourstore.com/api/meta/callback
# Webhook URL to set in Meta: https://yourstore.com/api/webhooks/meta
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=Luxe

# 2. X (TWITTER) LUXURY BROADCAST & CONCIERGE (X API v2)
# Obtain from: https://developer.x.com/
# OAuth 2.0 Redirect URI: https://yourstore.com/api/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 🟡 SECTION 6: TRANSACTIONAL EMAIL & NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
# Delivers customer order receipts, shipping alerts, password resets, and admin OTPs
# Compatible with SendGrid, Amazon SES, Mailgun, Brevo, Zoho, Gmail, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Luxe Boutique <orders@yourstore.com>"

# ------------------------------------------------------------------------------
# ⚪ SECTION 7: MEDIA STORAGE & CDN (CLOUDINARY VS. LOCAL DISK)
# ------------------------------------------------------------------------------
# If Cloudinary is omitted, product images upload seamlessly to local disk in /uploads/
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# ⚪ SECTION 8: DROPSHIPPING & 3PL FULFILLMENT PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Can also be entered dynamically in /admin -> Settings -> Fulfillment Providers
EPROLO_API_KEY=
EPROLO_API_SECRET=
PRINTFUL_API_KEY=
SHIPBOB_API_KEY=
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# ------------------------------------------------------------------------------
# 📱 SECTION 9: CUSTOMER MOBILE APP (EXPO / REACT NATIVE)
# ------------------------------------------------------------------------------
# Used when building or serving the mobile application in artifacts/luxe-boutique-mobile
EXPO_PUBLIC_DOMAIN=yourstore.com
EXPO_PUBLIC_API_URL=https://yourstore.com
